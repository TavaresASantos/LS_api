{
  "family": "lacrei-api-task-service-staging",
  "executionRoleArn": "arn:aws:iam::017535066797:role/lacrei_ecs_execution_role",
  "containerDefinitions": [
    {
      "name": "lacrei-container-staging",
      "image": "017535066797.dkr.ecr.us-east-1.amazonaws.com/lacrei-api-repo:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lacrei-api-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "staging"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024"
}