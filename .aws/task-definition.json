{
  "family": "lacrei-api-task",
  "executionRoleArn": "arn:aws:iam::935588737553:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "lacrei-api-container",
      "image": "935588737553.dkr.ecr.us-east-1.amazonaws.com/lacrei-api:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lacrei-api-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024"
}